# Copy this file to .env and fill in real values. .env is gitignored -- never commit it.
#
# Only API models actually use these. Local/open-weight models (Gemma, Qwen, Sarvam,
# Mistral, Phi-4, gpt-oss, etc.) need no API key -- see the root README for Hugging Face
# access/authentication for gated checkpoints and the MILU dataset instead.

# Used by: pipeline/run.py (deepseek-v4-flash)
DEEPSEEK_API_KEY=

# Used by: pipeline/run.py (OpenRouter-hosted configs, e.g. qwen3.8-max)
OPENROUTER_API_KEY=
