+# Real per-call token usage isn't captured anywhere upstream -- the harness's API
+# model classes extract only the answer text from each response and discard the
+# rest, including the `usage` field every OpenAI-compatible endpoint returns.
+# Appended to (not overwritten) so a killed/resumed run doesn't lose earlier
+# calls' usage; path is set via env var by pipeline/run.py so it lands under that
+# run's own output directory, not hardcoded here.
+_USAGE_LOG_PATH = os.environ.get("MILU_TOKEN_USAGE_LOG")
+
+
+def _log_usage(usage: Optional[dict], finish_reason: Optional[str] = None,
+               content_preview: Optional[str] = None) -> None:
+    if not _USAGE_LOG_PATH or not usage:
+        return
+    record = {
+        "prompt_tokens": usage.get("prompt_tokens"),
+        "completion_tokens": usage.get("completion_tokens"),
+        "total_tokens": usage.get("total_tokens"),
+    }
+    # completion_tokens is a COMBINED total (reasoning + visible answer) for
+    # reasoning models -- confirmed via a direct raw API call to qwen3.8-max
+    # (38 completion_tokens, 32 of them reasoning, only 6 for the actual
+    # answer). completion_tokens_details.reasoning_tokens is the real
+    # provider-reported split; not every provider/response includes it, so
+    # only recorded when present rather than defaulting to 0 (indistinguishable
+    # from "really zero reasoning tokens").
+    reasoning_tokens = (usage.get("completion_tokens_details") or {}).get("reasoning_tokens")
+    if reasoning_tokens is not None:
+        record["reasoning_tokens"] = reasoning_tokens
+    # finish_reason="length" is the authoritative truncation signal (hit
+    # max_tokens before the model chose to stop on its own) -- more reliable
+    # than inferring truncation from completion_tokens landing near the cap,
+    # and content_preview lets a truncated call be matched back to which
+    # item it was without relying on token_usage.jsonl's write order lining
+    # up with raw_items.jsonl's doc order (it doesn't necessarily, since
+    # concurrent requests can complete and log in a different order than
+    # they were dispatched in).
+    if finish_reason is not None:
+        record["finish_reason"] = finish_reason
+    if content_preview is not None:
+        record["content_preview"] = content_preview
+    with open(_USAGE_LOG_PATH, "a") as f:
+        f.write(json.dumps(record) + "\n")
+
 
